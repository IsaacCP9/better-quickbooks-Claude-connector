# QuickBooks Online MCP server — environment template.
# Copy to `.env` and fill in your Intuit Developer app keys. NEVER commit `.env`.
#
#   cp .env.example .env
#
# Get these from https://developer.intuit.com → your app → Keys & OAuth.
#
# Unofficial and independent. Not affiliated with, endorsed by, or sponsored by
# Intuit Inc. or Anthropic.

# App credentials (Client ID / Secret for your Intuit app).
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=

# Must match a Redirect URI registered on the Intuit app exactly.
#
# NOTE: this localhost address works with DEVELOPMENT keys only. Intuit rejects
# localhost and plain http for PRODUCTION apps — those need an https, non-localhost
# URL (e.g. an HTTPS tunnel in front of this port), registered on the app.
QBO_REDIRECT_URI=http://localhost:3000/callback

# `sandbox` (Intuit test companies) or `production` (real books).
# This only sets the environment used when authorizing a NEW company via
# `npm run connect`; each company's environment is then stored in its token file.
QBO_ENVIRONMENT=sandbox

# Optional: where tokens.<slug>.json files are kept. Defaults to this project
# folder. Set it to a path OUTSIDE any cloud-synced folder (Dropbox, iCloud Drive,
# OneDrive) if the project lives in one — otherwise your QuickBooks access passes
# are being synced to that service.
# QBO_DATA_DIR=

# Optional: default company for callers that don't pass one. Leave UNSET for the
# unified single-connector setup (you pick the company at runtime with
# select_company / the `company` argument). Set it only for a legacy
# one-connector-per-company setup.
# QBO_COMPANY=

# ---------------------------------------------------------------------------
# Before you connect real books, read:
#   README.md   → "What This Connector Can Reach"
#   SECURITY.md → the wrong-company and data-flow answers
#
# Three tools reach further than they sound like they do. attach_file uploads ANY
# local file path it is given to QuickBooks — including this .env and your
# tokens.*.json. import_transactions_from_csv reads any path and posts LIVE by
# default. api_request reaches every QBO operation, including hard deletes.
#
# Set those three to "Needs approval" or "Never" in Claude Desktop under
# Settings → Connectors → qbo → Tool permissions.
# ---------------------------------------------------------------------------
