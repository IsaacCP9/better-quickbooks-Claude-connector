# QuickBooks Online MCP server — environment template.
# Copy to `.env` and fill in your Intuit Developer app keys. NEVER commit `.env`.
#
#   cp .env.example .env
#
# Get these from https://developer.intuit.com → your app → Keys & OAuth.
#
# Your `.env` holds these secrets in PLAIN TEXT, at whatever file permissions your
# system defaults to, in this project folder. Don't copy it elsewhere, and consider
# `chmod 600 .env tokens*.json` on a shared machine. See SECURITY.md.

# App credentials (Client ID / Secret for your Intuit app).
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=

# Must match a Redirect URI registered on the Intuit app exactly.
# http://localhost:3000/callback works for Development (sandbox) keys.
# Production keys require a public https:// URL instead — see
# "Production redirect URI" in DEVELOPER.md and redirect-uri.sample.html.
QBO_REDIRECT_URI=http://localhost:3000/callback

# `sandbox` (Intuit test companies) or `production` (real books).
# This only sets the environment used when authorizing a NEW company via
# `npm run connect`; each company's environment is then stored in its token file.
QBO_ENVIRONMENT=sandbox

# Optional: default company for callers that don't pass one. Leave UNSET for the
# unified single-connector setup (you pick the company at runtime with
# select_company / the `company` argument). Set it only for a legacy
# one-connector-per-company setup.
# QBO_COMPANY=
